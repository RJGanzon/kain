# Copy to .env.local for local development. Only public values go in NEXT_PUBLIC_*.
# Without these the app runs on its bundled sample prices, on the device only.

# Supabase project URL and publishable (or anon) key.
# Local: run `supabase start` and copy API_URL and PUBLISHABLE_KEY from `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shows "Demo: activate without payment" on the Business plan screen (no real charge).
NEXT_PUBLIC_BUSINESS_DEMO=1
